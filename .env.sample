# AWS Credentials (for Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# LLM Provider selection
DISCOVERY_LLM_PROVIDER=bedrock      # Options: bedrock, ollama

# Bedrock Model IDs (optional — uses defaults if not set)
BEDROCK_TIER1_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_TIER2_MODEL=us.anthropic.claude-sonnet-4-6-v1:0
BEDROCK_TIER3_MODEL=us.anthropic.claude-opus-4-6-v1:0

# Ollama (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# DocHub API Integration (optional)
DISCOVERY_API_TOKEN=your-api-token
DISCOVERY_API_URL=https://api.example.com

# Gitea Integration (optional)
DISCOVERY_GITEA_TOKEN=your-gitea-token
DISCOVERY_GITEA_URL=https://gitea.example.com

# Budget & Limits
DISCOVERY_BUDGET_LIMIT_USD=50.0

# Output directory (default: ./data/discovery-output)
DISCOVERY_OUTPUT_DIR=./data/discovery-output

# Logging
LOG_LEVEL=INFO
