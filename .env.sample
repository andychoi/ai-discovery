# ─── AWS Bedrock (boto3 reads these automatically) ────────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# ─── LLM Provider Selection ────────────────────────────────────────────────
# Options: bedrock, ollama
# Bedrock: Uses AWS credentials above (production)
# Ollama: Local LLM server (development, requires local setup)
LLM_PROVIDER=bedrock

# ─── Bedrock Model Configuration (optional — uses defaults if not set) ─────
# Defaults from src/ai_discovery/shared/model_defaults.py
# Override here for custom model IDs:
# BEDROCK_TIER1_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_TIER2_MODEL=us.anthropic.claude-sonnet-4-6-v1:0
# BEDROCK_TIER3_MODEL=us.anthropic.claude-opus-4-6-v1:0

# ─── Ollama Configuration (if LLM_PROVIDER=ollama) ─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Discovery Pipeline Configuration ──────────────────────────────────────
# Budget limit in USD per scan
DISCOVERY_BUDGET_LIMIT_USD=50.0

# Output directory for scan results (SQLite DB + markdown docs)
DISCOVERY_OUTPUT_DIR=./data/discovery-output

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── DocHub API Integration (optional — for pushing results) ───────────────
# Bearer token for DocHub API (service-to-service auth)
DISCOVERY_API_KEY=your-api-key-here

# DocHub API base URL (where to push discovery results)
DISCOVERY_API_URL=http://localhost:8900

# ─── Gitea Integration (optional — alternative to DocHub API) ──────────────
# Gitea API token for pushing discovery results
DISCOVERY_GITEA_TOKEN=your-gitea-token-here

# Gitea instance URL
DISCOVERY_GITEA_URL=http://gitea.dev.test:8443

# ─── Optional: OpenAI / Google APIs (for experimentation) ───────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ─── Database & Storage ─────────────────────────────────────────────────────
# SQLite DB path (absolute path prevents stray DB files)
# Set to ./data/discovery.db for relative path, or absolute for consistency
DISCOVERY_DB_PATH=./data/discovery.db
