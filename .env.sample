# ─── LLM Provider Selection ────────────────────────────────────────────────
# Options: aigw | omlx | openrouter | bedrock | openai | gemini | anthropic
#   aigw       — local ai-gateway (OpenAI-compatible), default
#   omlx       — local OMLX host (OpenAI-compatible); only where installed
#   openrouter — OpenRouter cloud (OpenAI-compatible)
# Overrides `provider:` in discovery.yaml / .discovery/config.yaml.
DISCOVERY_LLM_PROVIDER=aigw
# Optional, apply to the active provider and win over its own vars below:
# API key, and one model used for every tier (tier1/tier2/tier3d/tier3p).
DISCOVERY_LLM_API_KEY=
DISCOVERY_LLM_MODEL=

# ─── Local ai-gateway ──────────────────────────────────────────────────────
# Virtual key whose metadata.models allowlist names every alias in discovery.yaml.
AIGW_BASE_URL=http://localhost:11433/v1
AIGW_API_KEY=

# ─── OMLX (only on hosts that run it) ──────────────────────────────────────
# OMLX_BASE_URL=http://localhost:11434/v1
# OMLX_API_KEY=

# ─── OpenRouter ─────────────────────────────────────────────────────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# ─── AWS Bedrock (only if DISCOVERY_LLM_PROVIDER=bedrock) ───────────────────
# AWS_REGION_NAME=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Optional: Anthropic Direct API (advisor tool beta) ─────────────────────
# If set, enables the native Anthropic advisor tool (requires 'anthropic').
ANTHROPIC_API_KEY=

# ─── Private repo cloning (https) ───────────────────────────────────────────
# GITHUB_TOKEN=          # github.com
# GITEA_TOKEN=           # any other git host
