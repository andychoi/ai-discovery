# AI-Discovery Configuration
# Customize discovery behavior, model selection, and optional features

# Provider: bedrock | ollama | mlx-gemma | mlx-qwen | openai | gemini | anthropic
provider: bedrock

# LLM cost limit (USD) — stops pipeline if exceeded
budget_limit_usd: 50.0

# Max concurrent workers for parallel processing
max_concurrent: 10

# Production mode: use tier3p (deep) instead of tier3d (standard) for doc generation
prod: false

# Bedrock configuration
bedrock:
  region: us-west-2
  tier1: "us.anthropic.claude-haiku-4-5-20251001-v1:0"
  tier2: us.anthropic.claude-sonnet-4-6
  tier3d: us.anthropic.claude-sonnet-4-6
  tier3p: us.anthropic.claude-opus-4-6

# RAG configuration
rag:
  embedding_provider: ollama
  bedrock_model: "amazon.titan-embed-text-v2:0"
  ollama_model: mxbai-embed-large
  chunk_size: 1500
  chunk_overlap: 200
  top_k: 5

# Flow Statistics Configuration (Phase 16) — OPTIONAL
# Set enabled: true to enable per-scenario flow statistics reports
process_mining:
  enabled: false
  max_traces: 10000
  output_reports: true

# Advisor Configuration (beta) — OPTIONAL
# Set enabled: true to enable advisor tool integration
advisor:
  enabled: false
  provider: auto
  model: claude-opus-4-7
  tiers: ['tier2', 'tier3']
  max_uses_per_call: 1
  tier3_executor_override: ""
